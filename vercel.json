{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [".env"]
      }
    },
    {
      "src": "frontend/RuleManager/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    { "src": "/auth/(.*)", "dest": "server.js" },
    { "src": "/oauth/(.*)", "dest": "server.js" },
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/(.*)", "dest": "frontend/RuleManager/$1" }
  ],
  "env": {
    "SF_CLIENT_ID": "@sf_client_id",
    "SF_CLIENT_SECRET": "@sf_client_secret",
    "SF_REDIRECT_URI": "@sf_redirect_uri"
  }
}